@page "/player"
@inject NavigationManager Navigation
@inject HttpClient Http

@using HaloStats.Web.Shared.Contracts.Player
@using MudBlazor
@using System.Web

<PageTitle>Player</PageTitle>

<MudPaper Class="pa-4">
    @if (gamertag != null)
    {
        <MudText Typo="Typo.h1">@gamertag</MudText>
    }

    @if (isLoading)
    {
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />
    }
    else if (player == null)
    {
        <MudText Color="Color.Error">Player not found.</MudText>
    }
    else
    {
        <MudText>GamesPlayedCount: @player.PlayerSummary.GamesPlayedCount</MudText>
        <MudText>TotalWins: @player.PlayerSummary.TotalWins</MudText>
        <MudText>TotalKills: @player.PlayerSummary.TotalKills</MudText>
        <MudText>TotalAssists: @player.PlayerSummary.TotalAssists</MudText>
        <MudText>TotalDeaths: @player.PlayerSummary.TotalDeaths</MudText>
        <MudText>WinPercentage: @player.PlayerSummary.WinPercentage.ToString("P1")</MudText>
        <MudText>KillDeathRatio: @player.PlayerSummary.KillDeathRatio.ToString("0.00")</MudText>
        <MudText>KillAssistDeathRatio: @player.PlayerSummary.KillAssistDeathRatio.ToString("0.00")</MudText>
        <MudDivider Class="my-4" />

        @if (gamesPlayed == null || isLoadingGameHistory)
        {
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />
        }
        else if (gamesPlayed.Games == null || gamesPlayed.Games.Count == 0)
        {
            <MudText>No game history found.</MudText>
        }
        else
        {
            <MudText Typo="Typo.h6">Game History (Page @gamesPlayed?.PageNumber)</MudText>
            <MudTable Items="gamesPlayed?.Games">
                <HeaderContent>
                    <MudTh>Date</MudTh>
                    <MudTh>Game Type Name</MudTh>
                    <MudTh>Score</MudTh>
                    <MudTh>Kills</MudTh>
                    <MudTh>Assists</MudTh>
                    <MudTh>Deaths</MudTh>
                    <MudTh>Is Matchmaking</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Date">@context.ReportedAt.ToString("g")</MudTd>
                    <MudTd DataLabel="Game Type Name">
                        <MudLink Href="@($"/game/{Uri.EscapeDataString(context.GameId.ToString())}")">
                            @context.GameTypeName
                        </MudLink>
                    </MudTd>
                    <MudTd DataLabel="Score">@context.Score</MudTd>
                    <MudTd DataLabel="Kills">@context.Kills</MudTd>
                    <MudTd DataLabel="Assists">@context.Assists</MudTd>
                    <MudTd DataLabel="Deaths">@context.Deaths</MudTd>
                    <MudTd DataLabel="Is Matchmaking">@context.IsMatchmaking</MudTd>
                </RowTemplate>
            </MudTable>
            <MudStack Direction="Row" Spacing="2" Class="mt-2">
                @if (gamesPlayed?.PageNumber > 1)
                {
                    <MudButton Variant="Variant.Filled" OnClick="PreviousPage">Previous</MudButton>
                }
                @if (gamesPlayed?.IsNextPage == true)
                {
                    <MudButton Variant="Variant.Filled" OnClick="NextPage">Next</MudButton>
                }
            </MudStack>
        }
        
    }
</MudPaper>

@code {
    private string? gamertag;
    private GetPlayerResponse? player;
    private GamesPlayed? gamesPlayed;
    private bool isLoading = true;
    private int currentPage = 1;
    private const int pageSize = 1;
    private bool isLoadingGameHistory = true;

    protected override async Task OnInitializedAsync()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = HttpUtility.ParseQueryString(uri.Query);
        var tag = query.Get("gamertag");
        if (!string.IsNullOrEmpty(tag))
        {
            gamertag = tag;
            await LoadPlayer();
        }
        else
        {
            isLoading = false;
        }
    }

    private async Task LoadPlayer()
    {
        isLoading = true;
        try
        {
            var response = await Http.GetFromJsonAsync<GetPlayerResponse>($"/api/player/{gamertag}");
            player = response;
            gamesPlayed = response?.GamesPlayed;
        }
        catch
        {
            player = null;
        }
        isLoading = false;
        isLoadingGameHistory = false;
        StateHasChanged();
    }

    private async Task LoadGameHistory()
    {
        isLoadingGameHistory = true;
        try
        {
            var response = await Http.GetFromJsonAsync<GamesPlayed>($"/api/player/{gamertag}/games?pageNumber={currentPage}&pageSize={pageSize}");
            gamesPlayed = response;
        }
        catch
        {
            gamesPlayed = null;
        }
        isLoadingGameHistory = false;
        StateHasChanged();
    }

    private async Task NextPage()
    {
        if (gamesPlayed?.IsNextPage == true)
        {
            currentPage++;
            await LoadGameHistory();
        }
    }

    private async Task PreviousPage()
    {
        if (gamesPlayed?.PageNumber > 1)
        {
            currentPage--;
            await LoadGameHistory();
        }
    }
}
