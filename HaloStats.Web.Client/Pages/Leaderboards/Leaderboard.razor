@page "/leaderboard/{game}"
@using HaloStats.Web.Shared.Contracts.Leaderboard
@using HaloStats.Web.Shared.Enums
@using HaloStats.Web.Shared.Constants
@using HaloStats.Web.Client.Infrastructure.Extensions

@inject HttpClient Http

<MudText Typo="Typo.h4">Leaderboards for</MudText>
<MudText Typo="Typo.h3">@GameDisplay</MudText>
<MudDivider />
@if (isLoading)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (errorMessage is not null)
{
    <MudAlert Severity="Severity.Error">@errorMessage</MudAlert>
}
else if (leaderboard is not null)
{

    <MudTable 
        T="LeaderboardPlayer" 
        ServerData="ReloadTopPlayersTable" 
        Dense="true" 
        @ref="topPlayers"
        RowsPerPage="10">

        <ToolBarContent>
            <MudText Typo="Typo.h4">Top Players (All Time)</MudText>
            <MudSpacer />
            <MudTextField T="string" ValueChanged="@(s => OnSearch(s))" Placeholder="Search" Adornment="Adornment.Start"
                AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
        </ToolBarContent>
        <HeaderContent>
            <MudTh>Rank</MudTh>
            <MudTh>Gamertag</MudTh>
            <MudTh><MudTableSortLabel SortLabel="@PageSettings.Leaderboard.SortKills" T="LeaderboardPlayer">Kills</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="@PageSettings.Leaderboard.SortKdr" T="LeaderboardPlayer">KDR</MudTableSortLabel></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Rank">@context.Rank</MudTd>
            <MudTd DataLabel="Gamertag">
                <MudLink Href="@($"/player?gamertag={Uri.EscapeDataString(context.Gamertag)}")">
                    @context.Gamertag
                </MudLink>
            </MudTd>
            <MudTd DataLabel="Kills">@context.Kills</MudTd>
            <MudTd DataLabel="KDR">@context.KillDeathRatio.ToString("0.00")</MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>No matching records found</MudText>
        </NoRecordsContent>
        <LoadingContent>
            <MudText>Loading...</MudText>
        </LoadingContent>
        <PagerContent>
            <MudTablePager PageSizeOptions="new int[] { 10, 25, 50, 100 }" />
        </PagerContent>
    </MudTable>

    <MudText Typo="Typo.h4" Class="mt-6">Top 10 Kill Leaders (This Month)</MudText>
    <MudTable Items="leaderboard.TopPlayersThisMonth.Records" Dense="true">
        <HeaderContent>
            <MudTh>Rank</MudTh>
            <MudTh>Gamertag</MudTh>
            <MudTh>Kills</MudTh>
            <MudTh>KDR</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Rank">@context.Rank</MudTd>
            <MudTd DataLabel="Gamertag">
                <MudLink Href="@($"/player?gamertag={Uri.EscapeDataString(context.Gamertag)}")">
                    @context.Gamertag
                </MudLink>
            </MudTd>
            <MudTd DataLabel="Kills">@context.Kills</MudTd>
            <MudTd DataLabel="KDR">@context.KillDeathRatio.ToString("0.00")</MudTd>
        </RowTemplate>
    </MudTable>

    <MudText Typo="Typo.h4" Class="mt-6">Top Teammate Pairs (Games Played Together)</MudText>
    <MudTable Items="leaderboard.TopTeammatePairs.Pairs" Dense="true">
        <HeaderContent>
            <MudTh>Rank</MudTh>
            <MudTh>Player 1</MudTh>
            <MudTh>Player 2</MudTh>
            <MudTh>Games Played</MudTh>
            <MudTh>Wins</MudTh>
            <MudTh>Losses</MudTh>
            <MudTh>Win Rate</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Rank">@context.Rank</MudTd>
            <MudTd DataLabel="Player 1">
                <MudLink Href="@($"/player?gamertag={Uri.EscapeDataString(context.PlayerOneGamertag)}")">
                    @context.PlayerOneGamertag
                </MudLink>
            </MudTd>
            <MudTd DataLabel="Player 2">
                <MudLink Href="@($"/player?gamertag={Uri.EscapeDataString(context.PlayerTwoGamertag)}")">
                    @context.PlayerTwoGamertag
                </MudLink>
            </MudTd>
            <MudTd DataLabel="Games Played">@context.GamesPlayedTogether</MudTd>
            <MudTd DataLabel="Wins">@context.WinsTogether</MudTd>
            <MudTd DataLabel="Losses">@context.LossesTogether</MudTd>
            <MudTd DataLabel="Win Rate">@context.WinRate.ToString("P1")</MudTd>
        </RowTemplate>
    </MudTable>

    <MudText Typo="Typo.h4" Class="mt-6">Top Teammate Pairs (By Wins)</MudText>
    <MudTable Items="leaderboard.TopTeammatePairsByWins.Pairs" Dense="true">
        <HeaderContent>
            <MudTh>Rank</MudTh>
            <MudTh>Player 1</MudTh>
            <MudTh>Player 2</MudTh>
            <MudTh>Games Played</MudTh>
            <MudTh>Wins</MudTh>
            <MudTh>Losses</MudTh>
            <MudTh>Win Rate</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Rank">@context.Rank</MudTd>
            <MudTd DataLabel="Player 1">
                <MudLink Href="@($"/player?gamertag={Uri.EscapeDataString(context.PlayerOneGamertag)}")">
                    @context.PlayerOneGamertag
                </MudLink>
            </MudTd>
            <MudTd DataLabel="Player 2">
                <MudLink Href="@($"/player?gamertag={Uri.EscapeDataString(context.PlayerTwoGamertag)}")">
                    @context.PlayerTwoGamertag
                </MudLink>
            </MudTd>
            <MudTd DataLabel="Games Played">@context.GamesPlayedTogether</MudTd>
            <MudTd DataLabel="Wins">@context.WinsTogether</MudTd>
            <MudTd DataLabel="Losses">@context.LossesTogether</MudTd>
            <MudTd DataLabel="Win Rate">@context.WinRate.ToString("P1")</MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    [Parameter] public string? Game { get; set; }

    private MudTable<LeaderboardPlayer> topPlayers;
    private string GameDisplay { get; set; } = "Unknown";
    private GetLeaderboardResponse leaderboard;
    private bool isLoading = true;
    private string? errorMessage;
    private string? filterTopLeaderboardGamertag;

    protected override async Task OnInitializedAsync()
    {
        HaloGames gameToLoad = MapRouteToGameEnum();
        var gameEnum = LeaderboardRouteMapper.MapRouteToGameEnum(Game);
        GameDisplay = LeaderboardRouteMapper.MapGameEnumToDescription(gameEnum);
        StateHasChanged();
    }

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        errorMessage = null;
        HaloGames gameToLoad = MapRouteToGameEnum();
        var gameEnum = LeaderboardRouteMapper.MapRouteToGameEnum(Game);
        GameDisplay = LeaderboardRouteMapper.MapGameEnumToDescription(gameEnum);
        await LoadLeaderboard(gameToLoad);
        StateHasChanged();
    }

    private async Task LoadLeaderboard(HaloGames game)
    {
        try
        {
            leaderboard = await Http.GetFromJsonAsync<GetLeaderboardResponse>($"/api/leaderboard/{game}");
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load leaderboard data: {ex.Message}";
        }
        isLoading = false;
    }

    private async Task<TableData<LeaderboardPlayer>> ReloadTopPlayersTable(TableState state, CancellationToken token)
    {
        var request = new GetLeaderboardPlayersRequest
        {
            SortDirection = state.SortDirection.ToSortDirection(),
            PageNumber = state.Page + 1,
            PageSize = state.PageSize,
            SortedBy = state.SortLabel,
            IsMonthly = false,
            SearchGamertag = filterTopLeaderboardGamertag
        };
        var game = MapRouteToGameEnum();
        var leaderboard = await Http.GetFromJsonAsync<GetLeaderboardPlayersResponse>($"/api/leaderboard/{game}/top-players?{ToQueryString(request)}");
        return new TableData<LeaderboardPlayer>
        {
            Items = leaderboard!.Records,
            TotalItems = leaderboard.TotalRecords
        };
    }

    private HaloGames MapRouteToGameEnum()
    {
        HaloGames gameToLoad;
        var gameEnum = LeaderboardRouteMapper.MapRouteToGameEnum(Game);
        if (gameEnum == null)
        {
            gameToLoad = HaloGames.HaloMccAll; // Default value
        }
        else
        {
            gameToLoad = gameEnum.Value;
        }
        return gameToLoad;
    }

    private void OnSearch(string gamertag)
    {
        filterTopLeaderboardGamertag = gamertag;
        topPlayers.ReloadServerData();
    }

    private string ToQueryString(GetLeaderboardPlayersRequest request)
    {
        var query = new List<string>
        {
            $"SortDirection={request.SortDirection}",
            $"PageNumber={request.PageNumber}",
            $"PageSize={request.PageSize}",
            $"IsMonthly={request.IsMonthly.ToString().ToLower()}"
        };

        if (!string.IsNullOrWhiteSpace(request.SortedBy))
            query.Add($"SortedBy={Uri.EscapeDataString(request.SortedBy)}");

        if (!string.IsNullOrWhiteSpace(request.SearchGamertag))
            query.Add($"SearchGamertag={Uri.EscapeDataString(request.SearchGamertag)}");

        return string.Join("&", query);
    }
}