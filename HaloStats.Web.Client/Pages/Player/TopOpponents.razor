@using HaloStats.Web.Shared.Contracts.Player
@using MudBlazor

@if (Data == null || Data.Opponents == null || Data.Opponents.Count == 0)
{
    <MudText>No data available.</MudText>
    return;
}

<MudText Typo="Typo.h6" Class="mt-4">Top Opponents</MudText>
<MudTable Items="Data.Opponents">
    <HeaderContent>
        <MudTh>Rank</MudTh>
        <MudTh>Gamertag</MudTh>
        <MudTh>Games Played Against</MudTh>
        <MudTh>Wins Against</MudTh>
        <MudTh>Losses Against</MudTh>
        <MudTh>Win Rate</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Rank">@context.Rank</MudTd>
        <MudTd DataLabel="Gamertag">
            <MudLink Href="@($"/player?gamertag={Uri.EscapeDataString(context.OpponentGamertag)}")">
                @context.OpponentGamertag
            </MudLink>
        </MudTd>
        <MudTd DataLabel="Games Played Against">@context.GamesPlayedAgainst</MudTd>
        <MudTd DataLabel="Wins Against">@context.WinsAgainst</MudTd>
        <MudTd DataLabel="Losses Against">@context.LossesAgainst</MudTd>
        <MudTd DataLabel="Win Rate">@context.WinRate.ToString("P1")</MudTd>
    </RowTemplate>
</MudTable>

@code {
    [Parameter] public HaloStats.Web.Shared.Contracts.Shared.TopOpponents? Data { get; set; }
}
