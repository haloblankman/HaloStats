@using HaloStats.Web.Shared.Constants;
@using HaloStats.Web.Shared.Contracts.Leaderboard
@using HaloStats.Web.Shared.Enums;
@page "/player"
@inject NavigationManager Navigation
@inject HttpClient Http
@implements IDisposable

@using HaloStats.Web.Shared.Contracts.Player
@using MudBlazor
@using System.Web

<PageTitle>Player</PageTitle>

@if (gamertag != null)
{
    <MudText Typo="Typo.h3">@gamertag</MudText>
}

@if (isLoading)
{
    <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />
}
else if (player == null)
{
    <MudText Color="Color.Error">Player not found.</MudText>
}
else
{
    <PlayerSummary Summary="player.PlayerSummary" />
    <MudDivider Class="my-4" />

    <MudTabs>
        <MudTabPanel Text="Game History">
            @if (gamesPlayed == null || isLoadingGameHistory)
            {
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />
            }
            else
            {
                <GamesPlayedTable GamesPlayed="gamesPlayed"
                    OnNextPage="NextPage"
                    OnPreviousPage="PreviousPage"
                    @bind-FilterByGamertag="filterByGamertag"
                    Gamertags="playedWithGamertags"
                    GamertagSearch="@GamertagSearch" />
            }
        </MudTabPanel>
        <MudTabPanel Text="Top Teammates">
            <MudStack>
                <TopTeammates Title="Top Teammates By Games Played Together" Game="HaloGames.HaloMccAll" IsMonthly="false" Gamertag="@gamertag" @ref="teammatesTable" />
                <TopTeammates Title="Top Teammates (past month)" Game="HaloGames.HaloMccAll" IsMonthly="true" Gamertag="@gamertag" @ref="monthlyTeammatesTable" />
            </MudStack>
        </MudTabPanel>
        <MudTabPanel Text="Top Opponents">
            <TopOpponents Data="player.TopOpponents" />
        </MudTabPanel>
    </MudTabs>
        
    <MudDivider Class="my-4" />
}

@code {
    private TopTeammates teammatesTable;
    private TopTeammates monthlyTeammatesTable;
    private string? gamertag;
    private GetPlayerResponse? player;
    private GetPlayerGamesResponse? gamesPlayed;
    private bool isLoading = true;
    private int currentPage = 1;
    private const int pageSize = PageSettings.DefaultPlayerGamesPageSize;
    private bool isLoadingGameHistory = true;
    private string? lastGamertag;
    private string? lastFilterByGamertag;
    private List<string> playedWithGamertags { get; set; } = new();
    private string? _filterByGamertag;
    private string? filterByGamertag
    {
        get => _filterByGamertag;
        set
        {
            if (_filterByGamertag != value)
            {
                _filterByGamertag = value;
                _ = GamertagSearch();
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += OnLocationChanged;
        await LoadFromQueryAsync();
    }


    private async void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        var uri = Navigation.ToAbsoluteUri(e.Location);
        var query = HttpUtility.ParseQueryString(uri.Query);
        var tag = query.Get("gamertag");
        var filter = query.Get("gamesPlayedWith");

        if (tag != lastGamertag || filter != lastFilterByGamertag)
        {
            gamertag = tag;
            filterByGamertag = filter;
            await LoadFromQueryAsync();
            await teammatesTable.ReloadAsync();
            await monthlyTeammatesTable.ReloadAsync();
            StateHasChanged();
        }
    }

    private async Task LoadFromQueryAsync()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = HttpUtility.ParseQueryString(uri.Query);
        var tag = query.Get("gamertag");
        var filter = query.Get("gamesPlayedWith");
        lastGamertag = tag;
        lastFilterByGamertag = filter;

        if (!string.IsNullOrEmpty(tag))
        {
            gamertag = tag;
            filterByGamertag = filter;
            await LoadPlayer();
            await LoadGamertags();
        }
        else
        {
            isLoading = false;
        }
    }

    private async Task LoadPlayer()
    {
        isLoading = true;
        try
        {
            var url = $"/api/player/{gamertag}";
            if (!string.IsNullOrEmpty(filterByGamertag))
            {
                url += $"?gamesPlayedWith={Uri.EscapeDataString(filterByGamertag)}";
            }

            var response = await Http.GetFromJsonAsync<GetPlayerResponse>(url);
            player = response;
            gamesPlayed = response?.GamesPlayed;
        }
        catch
        {
            player = null;
        }
        isLoading = false;
        isLoadingGameHistory = false;
        StateHasChanged();
    }

    private async Task GamertagSearch()
    {
        currentPage = 1;

        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);

        // Set or update the filterByGamertag parameter
        if (!string.IsNullOrEmpty(filterByGamertag))
            query.Set("gamesPlayedWith", filterByGamertag);
        else
            query.Remove("gamesPlayedWith");

        // Always preserve the gamertag parameter
        if (!string.IsNullOrEmpty(gamertag))
            query.Set("gamertag", gamertag);

        // Build the new URI
        var newUri = $"{uri.AbsolutePath}?{query}";
        Navigation.NavigateTo(newUri, forceLoad: false);

        await LoadGameHistory();
    }

    private Task HandleChange(ChangeEventArgs e)
    {
        return GamertagSearch();
    }

    private async Task LoadGamertags()
    {
        try
        {
            playedWithGamertags = await Http.GetFromJsonAsync<List<string>>($"/api/gamertag/search?playedWithGamertag={Uri.EscapeDataString(gamertag)}") ?? new List<string>();
        }
        catch
        {
            playedWithGamertags = new List<string>();
        }
    }

    private async Task LoadGameHistory()
    {
        isLoadingGameHistory = true;
        try
        {
            var url = $"/api/player/{gamertag}/games?pageNumber={currentPage}&pageSize={pageSize}";
            if (!string.IsNullOrEmpty(filterByGamertag))
            {
                url += $"&filterGamertag={Uri.EscapeDataString(filterByGamertag)}";
            }

            var response = await Http.GetFromJsonAsync<GetPlayerGamesResponse>(url);
            gamesPlayed = response;
        }
        catch
        {
            gamesPlayed = null;
        }
        isLoadingGameHistory = false;
    }

    private async Task NextPage()
    {
        if (gamesPlayed?.IsNextPage == true)
        {
            currentPage++;
            await LoadGameHistory();
        }
    }

    private async Task PreviousPage()
    {
        if (gamesPlayed?.PageNumber > 1)
        {
            currentPage--;
            await LoadGameHistory();
        }
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
