@using HaloStats.Web.Shared.Contracts.Player
@using MudBlazor

@if (GamesPlayed == null || GamesPlayed.Games == null || GamesPlayed.Games.Count == 0)
{
    <MudText>No game history found.</MudText>
}
else
{
    <MudPaper Class="pa-4 mt-4" Elevation="3">
        
        <MudStack Row="true" Spacing="3" Breakpoint="Breakpoint.None">
            <div class="filters-container">
                <MudAutocomplete T="string" 
                    Label="Find Games with.." 
                    Value="FilterByGamertag" 
                    ValueChanged="OnFilterByGamertagChanged" 
                    SearchFunc="@Search"
                    ResetValueOnEmptyText="true"
                    CoerceText="true" 
                    SelectValueOnTab="true" 
                    FullWidth="false"
                    MaxItems="100"
                    Clearable="true"
                    Class="filter-by-gamertag"
                    />
            </div>
        </MudStack>
    </MudPaper>
    <MudText Typo="Typo.h6">Game History (Page @GamesPlayed.PageNumber)</MudText>
    <MudTable Items="GamesPlayed.Games">
        <HeaderContent>
            <MudTh>Date</MudTh>
            <MudTh>Game Type Name</MudTh>
            <MudTh>Score</MudTh>
            <MudTh>Kills</MudTh>
            <MudTh>Assists</MudTh>
            <MudTh>Deaths</MudTh>
            <MudTh>Is Matchmaking</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Date">
                <LocalDate UtcDate="@context.ReportedAt" />
            </MudTd>
            <MudTd DataLabel="Game Type Name">
                <MudLink Href="@($"/game/{Uri.EscapeDataString(context.GameId.ToString())}")">
                    @context.GameTypeName
                </MudLink>
            </MudTd>
            <MudTd DataLabel="Score">@context.Score</MudTd>
            <MudTd DataLabel="Kills">@context.Kills</MudTd>
            <MudTd DataLabel="Assists">@context.Assists</MudTd>
            <MudTd DataLabel="Deaths">@context.Deaths</MudTd>
            <MudTd DataLabel="Is Matchmaking">@context.IsMatchmaking</MudTd>
        </RowTemplate>
    </MudTable>
    <MudStack Direction="Row" Spacing="2" Class="mt-2">
        @if (GamesPlayed.PageNumber > 1)
        {
            <MudButton Variant="Variant.Filled" OnClick="PreviousPage">Previous</MudButton>
        }
        @if (GamesPlayed.IsNextPage)
        {
            <MudButton Variant="Variant.Filled" OnClick="NextPage">Next</MudButton>
        }
    </MudStack>
}

@code {
    [Parameter] public GetPlayerGamesResponse? GamesPlayed { get; set; }
    [Parameter] public EventCallback OnNextPage { get; set; }
    [Parameter] public EventCallback OnPreviousPage { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> GamertagSearch { get; set; }
    [Parameter] public List<string> Gamertags { get; set; } = new();
    [Parameter] public string? FilterByGamertag { get; set; }
    [Parameter] public EventCallback<string?> FilterByGamertagChanged { get; set; }

    private async Task OnFilterByGamertagChanged(string newValue)
    {
        FilterByGamertag = newValue;
        await FilterByGamertagChanged.InvokeAsync(newValue);
    }

    private async Task NextPage() => await OnNextPage.InvokeAsync();
    private async Task PreviousPage() => await OnPreviousPage.InvokeAsync();

    private async Task<IEnumerable<string>?> Search(string? value, CancellationToken token)
    {
        if (string.IsNullOrEmpty(value))
            return Gamertags;
        return Gamertags.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }

    private async void ClearFilter()
    {
        FilterByGamertag = null;
        await FilterByGamertagChanged.InvokeAsync(null);
        await GamertagSearch.InvokeAsync(null);
    }
}

<style>
    .filters-container{
        display:flex;
        flex-direction: row;
    }

    @@media (max-width: 599.95px){
        .filters-container {
            flex-direction: row;
        }
    }
</style>