@page "/"

@using HaloStats.Web.Shared.Contracts.Dashboard
@inject HttpClient Http

<PageTitle>Halo PCRS</PageTitle>

<MudText Typo="Typo.h1">Halo Post Carnage Reports</MudText>
<MudDivider />
@if (isLoading)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (errorMessage is not null)
{
    <MudAlert Severity="Severity.Error">@errorMessage</MudAlert>
}
else if (dashboard is not null)
{
    <MudText Typo="Typo.h4">Top 10 Kill Leaders (All Time)</MudText>
    <MudTable Items="dashboard.TopPlayersByKillCount.Players" Dense="true">
        <HeaderContent>
            <MudTh>Rank</MudTh>
            <MudTh>GamerTag</MudTh>
            <MudTh>Kills</MudTh>
            <MudTh>KDR</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Rank">@context.Rank</MudTd>
            <MudTd DataLabel="GamerTag">
                <MudLink Href="@($"/player?gamertag={Uri.EscapeDataString(context.GamerTag)}")">
                    @context.GamerTag
                </MudLink>
            </MudTd>
            <MudTd DataLabel="Kills">@context.Kills</MudTd>
            <MudTd DataLabel="KDR">@context.KillDeathRatio.ToString("0.00")</MudTd>
        </RowTemplate>
    </MudTable>

    <MudText Typo="Typo.h4" Class="mt-6">Top 10 Kill Leaders (This Month)</MudText>
    <MudTable Items="dashboard.TopPlayersByKillCountThisMonth.Players" Dense="true">
        <HeaderContent>
            <MudTh>Rank</MudTh>
            <MudTh>GamerTag</MudTh>
            <MudTh>Kills</MudTh>
            <MudTh>KDR</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Rank">@context.Rank</MudTd>
            <MudTd DataLabel="GamerTag">
                <MudLink Href="@($"/player?gamertag={Uri.EscapeDataString(context.GamerTag)}")">
                    @context.GamerTag
                </MudLink>
            </MudTd>
            <MudTd DataLabel="Kills">@context.Kills</MudTd>
            <MudTd DataLabel="KDR">@context.KillDeathRatio.ToString("0.00")</MudTd>
        </RowTemplate>
    </MudTable>

    <MudText Typo="Typo.h4" Class="mt-6">Top Teammate Pairs (Games Played Together)</MudText>
    <MudTable Items="dashboard.TopTeammatePairs.Pairs" Dense="true">
        <HeaderContent>
            <MudTh>Rank</MudTh>
            <MudTh>Player 1</MudTh>
            <MudTh>Player 2</MudTh>
            <MudTh>Games Played</MudTh>
            <MudTh>Wins</MudTh>
            <MudTh>Losses</MudTh>
            <MudTh>Win Rate</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Rank">@context.Rank</MudTd>
            <MudTd DataLabel="Player 1">
                <MudLink Href="@($"/player?gamertag={Uri.EscapeDataString(context.PlayerOneGamerTag)}")">
                    @context.PlayerOneGamerTag
                </MudLink>
            </MudTd>
            <MudTd DataLabel="Player 2">
                <MudLink Href="@($"/player?gamertag={Uri.EscapeDataString(context.PlayerTwoGamerTag)}")">
                    @context.PlayerTwoGamerTag
                </MudLink>
            </MudTd>
            <MudTd DataLabel="Games Played">@context.GamesPlayedTogether</MudTd>
            <MudTd DataLabel="Wins">@context.WinsTogether</MudTd>
            <MudTd DataLabel="Losses">@context.LossesTogether</MudTd>
            <MudTd DataLabel="Win Rate">@context.WinRate.ToString("P1")</MudTd>
        </RowTemplate>
    </MudTable>

    <MudText Typo="Typo.h4" Class="mt-6">Top Teammate Pairs (By Wins)</MudText>
    <MudTable Items="dashboard.TopTeammatePairsByWins.Pairs" Dense="true">
        <HeaderContent>
            <MudTh>Rank</MudTh>
            <MudTh>Player 1</MudTh>
            <MudTh>Player 2</MudTh>
            <MudTh>Games Played</MudTh>
            <MudTh>Wins</MudTh>
            <MudTh>Losses</MudTh>
            <MudTh>Win Rate</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Rank">@context.Rank</MudTd>
            <MudTd DataLabel="Player 1">
                <MudLink Href="@($"/player?gamertag={Uri.EscapeDataString(context.PlayerOneGamerTag)}")">
                    @context.PlayerOneGamerTag
                </MudLink>
            </MudTd>
            <MudTd DataLabel="Player 2">
                <MudLink Href="@($"/player?gamertag={Uri.EscapeDataString(context.PlayerTwoGamerTag)}")">
                    @context.PlayerTwoGamerTag
                </MudLink>
            </MudTd>
            <MudTd DataLabel="Games Played">@context.GamesPlayedTogether</MudTd>
            <MudTd DataLabel="Wins">@context.WinsTogether</MudTd>
            <MudTd DataLabel="Losses">@context.LossesTogether</MudTd>
            <MudTd DataLabel="Win Rate">@context.WinRate.ToString("P1")</MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    private DashboardResponse? dashboard;
    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            dashboard = await Http.GetFromJsonAsync<DashboardResponse>("api/dashboard");
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load dashboard data: {ex.Message}";
        }
        isLoading = false;
    }
}