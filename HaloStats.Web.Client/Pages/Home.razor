@page "/"

@using HaloStats.Web.Shared.Contracts.Dashboard
@using HaloStats.Web.Shared.Enums
@using HaloStats.Web.Client.Infrastructure.Extensions
@inject HttpClient Http

<PageTitle>Halo PCRS</PageTitle>

<MudPaper Elevation="4" Class="pa-6 mb-6">
    <MudText Typo="Typo.h3" GutterBottom="true">Welcome to Halo PCRS</MudText>
    <MudText Typo="Typo.body1" GutterBottom="true">
        This website lets you view your past Halo games online.
        <br />
        <b>How does it work?</b> Download and run the Windows application from
        <MudLink Href="https://github.com/haloblankman/HaloStats/releases" Target="_blank">here</MudLink>.
        The app must be running to capture your games. Once captured, your game history will appear here for you to browse and analyze.
    </MudText>
    <MudAlert Severity="Severity.Info" Variant="Variant.Filled" Elevation="0" Dense="true" Class="mt-2">
        <MudText Typo="Typo.body2">
            <b>Note:</b> The Windows application must be running while you play to record your games.
        </MudText>
    </MudAlert>
</MudPaper>

<MudGrid>
    <MudItem xs="12">
        <MudPaper Elevation="2" Class="pa-4 d-flex flex-column align-center">
            <MudText Typo="Typo.h5" GutterBottom="true">Total Games Recorded</MudText>
            @if (dashboard == null)
            {
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
            }
            else
            {
                <MudText Typo="Typo.h2" Color="Color.Primary">@dashboard.TotalGames</MudText>
            }
        </MudPaper>
    </MudItem>
    <MudItem xs="12">
        <MudPaper Elevation="2" Class="pa-4">
            <MudText Typo="Typo.h5" GutterBottom="true">Recent Games</MudText>
            @if (dashboard == null)
            {
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
            }
            else if (dashboard.RecentGames == null || !dashboard.RecentGames.Any())
            {
                <MudText>No recent games found.</MudText>
            }
            else
            {
                <MudTable Items="dashboard.RecentGames" Dense="true" Breakpoint="Breakpoint.None" HorizontalScrollbar="true">
                    <HeaderContent>
                        <MudTh>Game</MudTh>
                        <MudTh>Game Type</MudTh>
                        <MudTh>Players</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Game">
                            <MudLink Href="@($"/game/{context.GameId}")">@context.GameTypeName</MudLink>
                        </MudTd>
                        <MudTd DataLabel="Game Type">@context.GameType</MudTd>
                        <MudTd DataLabel="Players">
                            @if (context.IsTeamGame)
                            {
                                foreach (var team in context.Teams!)
                                {
                                    <div class="team-and-score">
                                        <span>@team.TeamId.ToColor() (@team.Score) </span> 
                                        @foreach (var gamertag in team.Gamertags)
                                        {
                                            <MudLink Href="@($"/player?gamertag={Uri.EscapeDataString(gamertag)}")">@gamertag</MudLink><span>, </span>
                                        }
                                    </div>
                                }
                            }
                            else
                            {
                                foreach (var gamertag in context.NonTeamGame!.Gamertags)
                                {
                                    if (string.Equals(gamertag, context.NonTeamGame.WinnerGamertag, StringComparison.OrdinalIgnoreCase))
                                    {
                                        <b>
                                            <MudLink Href="@($"/player?gamertag={Uri.EscapeDataString(gamertag)}")">@gamertag</MudLink> (@context.NonTeamGame.Score)<span>, </span>
                                        </b>
                                    }
                                    else
                                    {
                                        <MudLink Href="@($"/player?gamertag={Uri.EscapeDataString(gamertag)}")">@gamertag</MudLink><span>, </span>
                                    }
                                    
                                }
                            }
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private DashboardResponse? dashboard;

    protected override async Task OnInitializedAsync()
    {
        dashboard = await Http.GetFromJsonAsync<DashboardResponse>("/api/dashboard");
    }
}