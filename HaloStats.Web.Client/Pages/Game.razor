@page "/game/{gameId:guid}"
@using HaloStats.Web.Shared.Contracts.Game
@using HaloStats.Web.Shared.Contracts.Shared
@using MudBlazor
@inject HttpClient Http

<PageTitle>Halo PCR</PageTitle>

@if (isLoading)
{
    <MudPaper Class="pcr-loading d-flex flex-column justify-center align-center">
        <MudProgressCircular Color="Color.Info" Indeterminate Size="MudBlazor.Size.Large" />
        <div class="mt-4 mud-text-body1">Loading game report...</div>
    </MudPaper>
}
else if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Elevation="6">
        @errorMessage
    </MudAlert>
}
else if (game is not null)
{
    <MudGrid Justify="Justify.SpaceAround">
        <MudItem xs="6">
            <MudText Typo="Typo.h4" Inline="false">@game.GameTypeName</MudText>
            @foreach (var team in game.TeamScores)
            {
                <MudGrid Justify="Justify.SpaceEvenly">
                    <MudItem xs="6">
                        <MudText Typo="Typo.h5" Style="@TeamTextColor(team.TeamId)">@team.TeamName</MudText>
                    </MudItem>
                    <MudItem xs="6">
                        <MudText Typo="Typo.h5" Style="@TeamTextColor(team.TeamId)">@team.Score</MudText>
                    </MudItem>
                </MudGrid>
            }
        </MudItem>
        <MudItem xs="6" style="display: flex; flex-direction: column; justify-content: flex-end;">
            <div style="display: flex; flex-direction: column; align-items: center;">
                <MudText Typo="Typo.h5" Class="pcr-section-title" Inline="false">
                    @if (pcrPage == 1)
                    {
                        @:Overview
                    }
                    else if (pcrPage == 2)
                    {
                        @:Weapon Type Stats
                    }
                    else if (pcrPage == 3)
                    {
                        @:Advanced Stats
                    }
                </MudText>
                <MudPagination Color="Color.Primary" Count="3" @bind-Selected="@pcrPage" />
            </div>
        </MudItem>
    </MudGrid>

    <div class="stats-slider mt-2">
        <div class="stats-slider-inner" style="@($"transform:translateX(-{(pcrPage - 1) * 100}%);")">
            <!-- Table 1: Core Scoreboard -->
            <div class="stats-panel">
                <MudTable Elevation="0" Items="game.GamePlayers" RowStyleFunc="RowStyle" Breakpoint="Breakpoint.None" HorizontalScrollbar="true">
                    <HeaderContent>
                        <MudTh>Gamertag</MudTh>
                        <MudTh>Score</MudTh>
                        <MudTh>Kills</MudTh>
                        <MudTh>Assists</MudTh>
                        <MudTh>Deaths</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Gamertag">
                            <MudLink Color="Color.Inherit" Href="@($"/player?gamertag={Uri.EscapeDataString(context.Gamertag)}")" Class="plain-link">
                                @context.Gamertag
                            </MudLink>
                        </MudTd>
                        <MudTd DataLabel="Score">
                            <span style="@GetHighlightStyle(context.IsHighestScore)">
                                @context.Score
                            </span>
                        </MudTd>
                        <MudTd DataLabel="Kills">
                            <span style="@GetHighlightStyle(context.IsHighestKills)">
                                @context.Kills
                            </span>
                        </MudTd>
                        <MudTd DataLabel="Assists">
                            <span style="@GetHighlightStyle(context.IsHighestAssists)">
                                @context.Assists
                            </span>
                        </MudTd>
                        <MudTd DataLabel="Deaths">
                            <span style="@GetHighlightStyle(context.IsLowestDeaths)">
                                @context.Deaths
                            </span>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            </div>

            <!-- Table 2: Kill Types -->
            <div class="stats-panel">
                <MudTable Elevation="0" Items="game.GamePlayers" RowStyleFunc="RowStyle" Breakpoint="Breakpoint.None" HorizontalScrollbar="true">
                    <HeaderContent>
                        <MudTh>Gamertag</MudTh>
                        <MudTh>Weapon</MudTh>
                        <MudTh>Grenade</MudTh>
                        <MudTh>Melee</MudTh>
                        <MudTh>Other</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Gamertag">
                            <MudLink Color="Color.Inherit" Href="@($"/player?gamertag={Uri.EscapeDataString(context.Gamertag)}")" Class="plain-link">
                                @context.Gamertag
                            </MudLink>
                        </MudTd>
                        <MudTd DataLabel="WeaponKills">@context.WeaponKills</MudTd>
                        <MudTd DataLabel="GrenadeKills">@context.GrenadeKills</MudTd>
                        <MudTd DataLabel="MeleeKills">@context.MeleeKills</MudTd>
                        <MudTd DataLabel="OtherKills">@context.OtherKills</MudTd>
                    </RowTemplate>
                </MudTable>
            </div>

            <!-- Table 3: Survivability / Other -->
            <div class="stats-panel">
                <MudTable Elevation="0" Items="game.GamePlayers" RowStyleFunc="RowStyle" Breakpoint="Breakpoint.None" HorizontalScrollbar="true">
                    <HeaderContent>
                        <MudTh>Gamertag</MudTh>
                        <MudTh>AverageLife</MudTh>
                        <MudTh>Spread</MudTh>
                        <MudTh>Spree</MudTh>
                        <MudTh>Medals</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Gamertag">
                            <MudLink Color="Color.Inherit" Href="@($"/player?gamertag={Uri.EscapeDataString(context.Gamertag)}")" Class="plain-link">
                                @context.Gamertag
                            </MudLink>
                        </MudTd>
                        <MudTd DataLabel="AverageLife">@FormatAverageLife(context)</MudTd>
                        <MudTd DataLabel="KillDeathSpread">@FormatKDSpread(context.KillDeathSpread)</MudTd>
                        <MudTd DataLabel="Spree">@context.Spree</MudTd>
                        <MudTd DataLabel="Medals">@context.Medals</MudTd>
                    </RowTemplate>
                </MudTable>
            </div>
        </div>
    </div>
}
else
{
    <MudAlert Severity="Severity.Info">No game data.</MudAlert>
}

@code {
    [Parameter] public Guid? GameId { get; set; }

    private bool isLoading = true;
    private string? errorMessage;
    private GetGameResponse? game;
    private TeamScore? winningTeam;
    private int pcrPage = 1;

    protected override async Task OnParametersSetAsync()
    {
        if (GameId.HasValue)
        {
            await LoadGame();
        }
    }

    private async Task LoadGame()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            game = await Http.GetFromJsonAsync<GetGameResponse>($"/api/game/{GameId}");
            if (game != null && game.IsTeamsEnabled && game.TeamScores is not null)
            {
                winningTeam = game.TeamScores.First(t => t.IsWinner);
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load game data: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private string RowStyle(GamePlayerStats p, int i)
    {
        if (game?.IsTeamsEnabled == true)
        {
            return $"background:{TeamColor(p.TeamId)};";
        }
        return "";
    }

    private static string TeamColor(int teamId)
    {
        return teamId switch
        {
            0 => "#B71C1C",
            1 => "#0D47A1",
            2 => "#009688",
            3 => "#E65100",
            4 => "#3E2723",
            5 => "#FAFAFA",
            6 => "#C51162",
            7 => "#FBC02D",
            8 => "#263238",
            9 => "#6200EA",
            _ => "#212121",
        };
    }

    private static string TeamTextColor(int teamId) => $"color:{TeamColor(teamId)};";

    private static string FormatSeconds(int seconds)
        => TimeSpan.FromSeconds(seconds).ToString(@"m\:ss");

    private static string FormatAverageLife(GamePlayerStats p)
    {
        var deaths = p.Deaths <= 0 ? 1 : p.Deaths;
        var avg = p.SecondsAlive / deaths;
        return FormatSeconds(avg);
    }

    private static string GetHighlightStyle(bool highlight)
        => highlight ? "font-weight:bold;color:#FFF59D;" : "";

    private static string FormatKDSpread(int kdSpread)
    {
        return kdSpread >= 0 ? $"+{kdSpread}" : kdSpread.ToString();
    }
}
<style>
    .stats-slider {
        position: relative;
        overflow: hidden;
        width: 100%;
    }

    .stats-slider-inner {
        display: flex;
        transition: transform .18s ease-out;
        will-change: transform;
    }

    .stats-panel {
        flex: 0 0 100%;
        padding-right: 0.5rem;
    }

        .stats-panel .mud-table {
            min-width: 100%;
        }

    .plain-link {
        color: inherit !important;
        text-decoration: none;
        font-weight: inherit;
    }

    .pcr-section-title {
        font-size: 1rem;
        font-weight: 600;
        margin-bottom: 0.5rem;
    }

    @@media (max-width: 599.95px){
        .mud-table-cell { padding: 2px; }
    }
</style>